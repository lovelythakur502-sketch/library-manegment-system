SELECT *
FROM Books
WHERE Title LIKE '%Database%';

START TRANSACTION;

UPDATE Books
SET Quantity = Quantity - 1
WHERE BookID = 1 AND Quantity > 0;

SET @book_issued = ROW_COUNT();

INSERT INTO BookIssues
    (BookID, StudentID, IssueDate, Status)
SELECT 1, 1, CURDATE(), 'Issued'


WHERE @book_issued = 1;

COMMIT;

SELECT
    Students.StudentName,
    Books.Title,
    BookIssues.IssueDate,
    BookIssues.ReturnDate,
    BookIssues.Status
FROM BookIssues
JOIN Students
    ON BookIssues.StudentID = Students.StudentID
JOIN Books
    ON BookIssues.BookID = Books.BookID;

START TRANSACTION;

UPDATE BookIssues
SET Status = 'Returned',
    ReturnDate = CURDATE()
WHERE IssueID = 1 AND Status = 'Issued';

SET @was_returned = ROW_COUNT();

UPDATE Books
SET Quantity = Quantity + 1
WHERE BookID = (
    SELECT BookID
    FROM BookIssues
    WHERE IssueID = 1
) AND @was_returned = 1;

COMMIT;


SELECT *
FROM Books
WHERE Quantity > 0;

SELECT
    COUNT(*) AS TotalBookTitles,
    SUM(Quantity) AS AvailableCopies
FROM Books;


